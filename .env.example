# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://odi.studio,https://www.odi.studio
TRUST_PROXY=1

# ── Firebase (Auth) ───────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
# Optional, but required to permanently delete customers (Firebase Auth user management):
# Firebase Console → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Supabase (Database) ───────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
# Keys: Dashboard → Account & Settings → API Keys (Test or Live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public webhook URL — paste this into Razorpay Dashboard → Webhooks.
# Razorpay cannot call localhost. Same URL for Test and Live (toggle mode in the dashboard).
RAZORPAY_WEBHOOK_URL=
# Secret: created in Razorpay Dashboard when you add the webhook. Paste it here — do not invent one.
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
MAIL_FROM=ODI <odistudio24@gmail.com>
# Public site URL used in email buttons
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://odi.studio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ── Delhivery (Shipping) ───────────────────────────────────────────────────────
DELHIVERY_STAGING_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_PRODUCTION_BASE_URL=https://track.delhivery.com
DELHIVERY_MOT=S
DELHIVERY_PDT=Pre-paid

# Staging (local QA) — or comment this block and uncomment production
DELHIVERY_ENV=staging
DELHIVERY_ACCOUNT_TYPE=b2b
DELHIVERY_STAGING_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_ORIGIN_PIN=
DELHIVERY_PICKUP_LOCATION_NAME=
DELHIVERY_WAREHOUSE_REGISTERED_NAME=
DELHIVERY_WAREHOUSE_ADDRESS=
DELHIVERY_WAREHOUSE_CITY=
DELHIVERY_WAREHOUSE_STATE=
DELHIVERY_WAREHOUSE_PHONE=
DELHIVERY_WAREHOUSE_EMAIL=

# Production
# DELHIVERY_ENV=production
# DELHIVERY_ACCOUNT_TYPE=b2c
# DELHIVERY_PRODUCTION_TOKEN=
# DELHIVERY_CLIENT_NAME=
# DELHIVERY_ORIGIN_PIN=
# DELHIVERY_PICKUP_LOCATION_NAME=
# DELHIVERY_WAREHOUSE_REGISTERED_NAME=
# DELHIVERY_WAREHOUSE_ADDRESS=
# DELHIVERY_WAREHOUSE_CITY=
# DELHIVERY_WAREHOUSE_STATE=
# DELHIVERY_WAREHOUSE_PHONE=
# DELHIVERY_WAREHOUSE_EMAIL=
