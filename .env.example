# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Set this to the number of trusted reverse-proxy hops in production.
# Common single-proxy deployments use 1. Keep false when running directly.
TRUST_PROXY=false

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Firebase (Auth) ───────────────────────────────────────────────────────────
# Project ID is enough to VERIFY ID tokens.
FIREBASE_PROJECT_ID=odi-studio-b1e45

# Optional but recommended for production:
# Download from Firebase Console → Project Settings → Service Accounts →
# "Generate new private key", save the file next to this project and set:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Supabase (Database) ───────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the SERVICE ROLE key (server-side only — never expose to the frontend!)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public Storage bucket for product images (upload via Supabase Dashboard).
# API stores image URLs in product_images.url — it does not proxy file uploads.
SUPABASE_STORAGE_BUCKET=product-images

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
# Dashboard → Settings → API Keys (use test keys in development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Dashboard → Settings → Webhooks → secret for POST /payments/webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ── Email (Gmail SMTP via odistudio24@gmail.com) ───────────────────────────────
MAIL_FROM=ODI <odistudio24@gmail.com>
FRONTEND_URL=http://localhost:5173
MAIL_LOGO_URL=https://joiezvghtlyeyhuyvnwl.supabase.co/storage/v1/object/public/product-images/brand/odi-email-logo.png
MAIL_INSTAGRAM_URL=https://www.instagram.com/odi3dstudio/
MAIL_FACEBOOK_URL=https://www.facebook.com/people/Oceaniek-Dimension-Industries/61589448369192/
MAIL_LINKEDIN_URL=https://www.linkedin.com/company/odistudioglobal
MAIL_YOUTUBE_URL=https://www.youtube.com/@ODI.STUDIO
# Optional social profile links used in email footers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=odistudio24@gmail.com
# Google Account → Security → 2-Step Verification → App passwords
SMTP_PASS=
